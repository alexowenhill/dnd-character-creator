# Copy to .env.local for local development, and set the same values in
# Netlify under Site configuration → Environment variables.

# Required. The single password everyone on the table types to get in.
# There are no usernames — this is the whole login.
PARTY_PASSWORD=pick-something-memorable

# Recommended. Signs the session cookie. Any long random string.
# Falls back to PARTY_PASSWORD if unset, which works but means changing the
# password invalidates nothing else.
SESSION_SECRET=

# Optional. The level new characters start at. Defaults to 5.
PARTY_LEVEL=5

# Optional. One D&D Yonder account, shared by the whole site, used only for
# dice rolls, name suggestions, spells and items. Pick any email and password —
# nothing needs registering by hand first, the app logs in on first use and
# registers the account automatically if it does not exist yet. Leave both
# blank and everything falls back to local behaviour: dice are rolled with the
# platform's secure random number generator and names/spells/items are simply
# not offered.
# Characters are never stored there; character creation is broken upstream
# (see README — "About the D&D Yonder API").
YONDER_EMAIL=
YONDER_PASSWORD=
# Optional. The display name used if the account above needs registering.
# Defaults to "The Party".
YONDER_NAME=
